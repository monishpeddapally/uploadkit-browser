{
  "name": "@uploadkit/browser",
  "version": "0.1.0",
  "description": "Prepare images in the browser before uploading them to storage.",
  "author": "Monish Peddapally",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monishpeddapally/uploadkit-browser.git"
  },
